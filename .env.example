# ─── Required in production ────────────────────────────────────────────────

# Verifies Supabase session tokens. This server no longer ISSUES tokens --
# Supabase Auth does -- so this must be the project's own secret, not a value you
# invent. Copy it from Supabase -> Project Settings -> API -> JWT Settings.
# There is no fallback: without it every request fails 401.
SUPABASE_JWT_SECRET=""

# Postgres connection string for the Supabase database. On this branch the API
# itself stores data in a local SQLite file (see DB_PATH below); DATABASE_URL is
# read only by `npm run migrate:supabase`, `scripts/local-smoke.ts` and the
# access-matrix test suite. Supabase -> Project Settings -> Database -> URI.
DATABASE_URL=""

# SQLite file the API opens, relative to the working directory. On a container
# host point this at a mounted volume so data survives redeploys.
DB_PATH="city_healer.db"

# Supabase project URL and anon key, compiled into the browser bundle by Vite.
# The anon key is designed to be public -- it carries no privileges beyond what
# row-level security allows. Never put the service_role key in a VITE_ variable:
# it bypasses RLS entirely and would ship to every visitor.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Must be "production" on a deployed host. Anything else starts the Vite dev
# middleware instead of serving the built frontend from dist/.
NODE_ENV="production"

# ─── Optional ──────────────────────────────────────────────────────────────

# Set by the host. Falls back to 3000 locally.
PORT="3000"

# Anonymous access, off unless explicitly enabled. When true an unauthenticated
# caller is bound to a synthetic identity (uid demo-sandbox-user) whose uid
# matches no real patient, so ownership-scoped queries return nothing belonging
# to a real person. Enable this for a public demo; leave it false for anything
# holding real data.
DEMO_MODE="false"

# In DEMO_MODE the sandbox identity takes its role from the UI's role switcher
# (sent as the X-Demo-Role header) and, as a DOCTOR, acts as this seeded clinician
# so the doctor console has a queue and appointments to work with.
DEMO_DOCTOR_ID="doc-1"

# Gemini key for AI diagnostic suggestions. Used server-side only — it is never
# sent to the browser. Without it the AI paths fall back to canned responses
# rather than failing the request.
GEMINI_API_KEY=""

# Requests per window for the AI endpoints. Defaults are applied if unset.
AI_RATE_LIMIT=""

# Serve the API only and skip the frontend middleware entirely. Useful if the
# frontend is hosted separately.
API_ONLY="false"
